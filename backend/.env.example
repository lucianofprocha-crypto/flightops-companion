# Copie este arquivo para ".env" (mesma pasta, backend/) e preencha com as
# credenciais recebidas por e-mail do DECEA (API AISWEB).
#
# Em produção (Render), NÃO use este arquivo — configure as mesmas
# variáveis no painel do serviço (Environment).
#
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

AISWEB_API_KEY=
AISWEB_API_PASS=
